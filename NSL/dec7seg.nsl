module dec7seg {

function do
 any {
  hx == 0x0: seg = 0xfc;
  hx == 0x1: seg = 0x60;
  hx == 0x2: seg = 0xda;
  hx == 0x3: seg = 0xf2;
  hx == 0x4: seg = 0x66;
  hx == 0x5: seg = 0xb6;
  hx == 0x6: seg = 0xbe;
  hx == 0x7: seg = 0xe0;
  hx == 0x8: seg = 0xfe;
  hx == 0x9: seg = 0xe6;
  hx == 0xa: seg = 0xee;
  hx == 0xb: seg = 0x3e;
  hx == 0xc: seg = 0x9c;
  hx == 0xd: seg = 0x7a;
  hx == 0xe: seg = 0x9e;
  hx == 0xf: seg = 0x8e;
  }
}
