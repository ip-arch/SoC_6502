/*******************************************************************************
*sound: 4bit DAC control module
********************************************************************************
* 2014.12.24   Initial version  by T.Furukawa
*******************************************************************************/

#include "sound.inc"

module sound {
	reg		DAC_i[4];

	
	DAC=DAC_i;

	function read {
		return {4'b0,DAC_i};
	}

	function write {
		DAC_i:=datai[3:0];
	}
}
